# dev.env has all the environment variables commonly used by the scripts in
# this directory. It is sourced by the scripts in this directory, so you can 
# override.

# change the variables below to point to your workspace and vpp source directory
WS_ROOT=${HOME}/workspace
VPP_ROOT_DIR=${HOME}/opensrc
VPP_SRC_DIR=${VPP_ROOT_DIR}/vpp
VPP_DOCKER_DIR=${WS_ROOT}/DockerPlayground/ubuntu-vpp

# Target directory inside the container where the source code will be mounted
MNT_DIR_TGT=/workspace

# Docker image name to use for the VPP development environment
VPPDEV_IMAGE="vpp-dev-env"

# Container names for the VPP development environment
VPPDEV_CNR_1="vpp-dev-1"
VPPDEV_CNR_2="vpp-dev-2"
VPPDEV_CNR="vpp-dev-container"
